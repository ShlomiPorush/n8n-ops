{
  "name": "@n8n-ops/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/healthcheck.ts src/cli.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@n8n-ops/shared": "workspace:*",
    "age-encryption": "0.3.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "nodemailer": "10.1.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "vitest": "5.0.4"
  }
}
