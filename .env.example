# n8n-ops environment contract. Copy to .env and replace every placeholder.
# Never commit .env.

# --- Compose interpolation (resolved by Compose itself) ---
# Image tag published by the release workflow, for example 0.1.0.
N8N_OPS_VERSION=latest
# Host port for the web UI and API.
N8N_OPS_PORT=8080
# Host directory for persistent data: <dir>/server (owned by UID 1000) and <dir>/postgres.
N8N_OPS_DATA_DIR=/srv/n8n-ops

# --- PostgreSQL ---
POSTGRES_USER=n8n_ops
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=n8n_ops

# --- Server ---
# Public HTTPS URL of this installation. Required behind a reverse proxy: it enables secure cookies,
# is trusted for sign-in requests and is used in links sent by Telegram and email.
N8N_OPS_PUBLIC_URL=https://n8n-ops.example.com
# Must match the PostgreSQL values above.
DATABASE_URL=postgres://n8n_ops:replace-with-a-long-random-password@postgres:5432/n8n_ops

# --- Worker (only with "docker compose --profile worker") ---
# URL the worker uses to reach the server.
N8N_OPS_SERVER_URL=https://n8n-ops.example.com
# Host directory for the worker identity file.
N8N_OPS_WORKER_DIR=/srv/n8n-ops-worker
# Group ID that owns /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock).
DOCKER_SOCKET_GID=999
