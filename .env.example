# Copy to .env next to docker-compose.yml and fill in. Example values only: never commit .env.
#
# Two kinds of variables live here. "Compose" variables are read by docker compose itself while it
# reads docker-compose.yml. "App" variables reach the server through env_file. Everything else
# (n8n instances, Telegram, email, storage) is set in the product.

# --- Compose: deployment ---
# Image tag to run: the release being deployed, for example 0.1.0. No default on purpose, so an
# unset value fails instead of resolving to "latest".
VERSION=0.1.0
# Public host name Traefik routes to n8n-ops.
DOMAIN=n8n-ops.example.com

# --- Compose and app: database ---
POSTGRES_HOST=postgres
POSTGRES_DB=n8n_ops
POSTGRES_USER=n8n_ops
# Letters, digits and hyphens only: it is also part of DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}

# --- App ---
# Public HTTPS URL users open. It enables secure cookies, is trusted for sign-in requests and is used
# in links sent by Telegram and email.
N8N_OPS_PUBLIC_URL=https://${DOMAIN}
