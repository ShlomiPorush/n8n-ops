# The disposable n8n of the development stack and the end-to-end tests. The scripts fill N8N_ENCRYPTION_KEY with a
# new random key. Never put a real value here.
N8N_ENCRYPTION_KEY=
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_SECURE_COOKIE=false
N8N_METRICS=true
EXECUTIONS_DATA_SAVE_ON_ERROR=all
